# Local-only values that make the Docker demo runnable. Replace all sample secrets before deployment.
# Database name used by MySQL and the API container.
DB_NAME=smartcrm_l8
# Database account used by the API.
DB_USER=smartcrm
# Sample database password; use a new value outside this local demo.
DB_PASSWORD=smartcrm_local_demo_password
# Sample MySQL root password for first-run initialization and isolated tests.
MYSQL_ROOT_PASSWORD=local_demo_root_password
# Host port serving the React application.
APP_PORT=3000
# Sample internal service key; replace with `openssl rand -hex 32` for deployment.
SERVICE_API_KEY=local-demo-service-key-0123456789abcdef
# Sample JWT signing key; replace with `openssl rand -hex 32` for deployment.
JWT_SECRET=local-demo-jwt-secret-0123456789abcdef
# Create demo role accounts on startup; existing accounts are not overwritten.
BOOTSTRAP_ENABLED=true
# Sample demo password; choose a new value before deployment.
BOOTSTRAP_PASSWORD=DemoPasswordOnly123
# Public URL used to build survey links in the local demo.
SURVEY_PUBLIC_BASE_URL=http://localhost:3000/khao-sat
# Simulate message gateway failures only when explicitly testing retry behavior.
GATEWAY_SIMULATE_FAILURE=false
# Number of days a survey link stays valid.
SURVEY_EXPIRY_DAYS=7
# Enable the background invitation scheduler.
SURVEY_SCHEDULER_ENABLED=true
# Optional frontend proxy override (PowerShell environment before npm run dev):
# VITE_API_TARGET=http://127.0.0.1:8080
# Test resources have isolated localhost:3307 defaults; never point them at a working DB.
# Optional overrides: TEST_DB_URL, TEST_DB_USER, TEST_DB_PASSWORD.
# Browser E2E only: E2E_BASE_URL, E2E_SERVICE_KEY, E2E_SURVEY_TOKEN,
# E2E_TICKET_CODE, E2E_PASSWORD, E2E_MANAGER_USERNAME,
# E2E_MARKETING_USERNAME, E2E_DIRECTOR_USERNAME; see frontend/README.md.
